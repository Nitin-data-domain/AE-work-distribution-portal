# ============================================================
# College Grievance Portal — Server Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# PostgreSQL (Neon / Supabase / Local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# JWT — use a long random string (min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_replace_this_in_production

# College Name (shown in emails and health check)
COLLEGE_NAME=Your College Name

# Google Webhook Secret (must match Google Apps Script)
WEBHOOK_SECRET=COLLEGE_GRIEVANCE_SECRET_2026

# ── Email Configuration ──────────────────────────────────────
# Option A: Gmail SMTP (recommended for VPS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_gmail_app_password

# Option B: Google Apps Script Proxy (for shared hosting)
# GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ── Server Config ────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── CORS (comma-separated allowed frontend origins)
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173

# ── Keep-alive URL (for hosted environments like Render)
# APP_URL=https://your-backend-url.com
